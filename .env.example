# ============================================
# 企业级智能文档分析平台 - 环境变量配置
# ============================================

# ---------- 应用配置 ----------
APP_NAME=Document Analysis Platform
DEBUG=true
API_PREFIX=/api

# ---------- 数据库配置 ----------
DATABASE_URL=sqlite+aiosqlite:///./data/database.db

# ---------- 主模型配置(通义千问) ----------
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=your_qwen_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 备用模型配置(DeepSeek) ----------
BACKUP_LLM_PROVIDER=deepseek
BACKUP_LLM_MODEL=deepseek-chat
BACKUP_LLM_API_KEY=your_deepseek_api_key_here
BACKUP_LLM_BASE_URL=https://api.deepseek.com/v1

# ---------- Embedding配置 ----------
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# ---------- 各场景Temperature配置 ----------
TEMPERATURE_DOCUMENT_QA=0.3
TEMPERATURE_GENERAL_QA=0.7
TEMPERATURE_CHITCHAT=0.8
TEMPERATURE_HYBRID=0.5

# ---------- 检索配置 ----------
DEFAULT_TOP_K=3
RRF_K=60

# ---------- 重试配置 ----------
RETRY_TIMES=3
RETRY_BACKOFF=1.0

# ---------- 性能配置 ----------
MAX_CONCURRENT_USERS=10
REQUEST_TIMEOUT=30